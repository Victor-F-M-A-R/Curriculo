{
  "openapi": "3.1.0",
  "info": {
    "title": "Doca Norte · Operações de pátio",
    "version": "1.1.0"
  },
  "paths": {
    "/api/yard": {
      "get": {
        "summary": "Ler docas e movimentos recentes",
        "responses": {
          "200": {
            "description": "Leitura transacional do pátio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "description": "Identidade ausente, expirada ou antiga; efetue novo login."
          },
          "503": {
            "description": "Banco indisponível ou tempo limite excedido; repetir leitura após Retry-After."
          }
        },
        "description": "Em modo OIDC exige identidade ainda válida ou X-Yard-Reader configurado para a portaria. Nunca armazene esse token no navegador.",
        "parameters": [
          {
            "name": "X-Yard-Reader",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Token de serviço somente para leitura, quando configurado."
          }
        ]
      }
    },
    "/api/session": {
      "get": {
        "summary": "Obter identidade e token CSRF da sessão atual",
        "responses": {
          "200": {
            "description": "Sessão HTTP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/docks/{id}/moves": {
      "post": {
        "summary": "Aplicar transição à doca e registrar evento",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado atual após execução ou replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dock"
                }
              }
            }
          },
          "400": {
            "description": "Comando ou UUID inválido"
          },
          "403": {
            "description": "CSRF ou permissão de operador ausente"
          },
          "404": {
            "description": "Doca desconhecida"
          },
          "409": {
            "description": "Conflito de versão, estado ou idempotência"
          },
          "413": {
            "description": "Corpo maior que 16 KiB, inclusive transferência sem Content-Length."
          },
          "503": {
            "description": "Falha transitória de persistência; atualizar leitura e repetir com a mesma chave quando necessário."
          }
        },
        "description": "JSON até 16 KiB, sem propriedades repetidas/desconhecidas e sem coerção de tipos. Em confirmação perdida, mantenha Idempotency-Key, ator e comando originais ao repetir. Atualize a leitura após conflito. Identidade OIDC expirada ou antiga não autoriza escrita."
      }
    }
  },
  "components": {
    "schemas": {
      "Dock": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cargo",
          "carrier",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[1-6]$"
          },
          "name": {
            "type": "string"
          },
          "cargo": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "status": {
            "enum": [
              "free",
              "booked",
              "servicing"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Movement": {
        "type": "object",
        "required": [
          "dockId",
          "dockVersion",
          "action",
          "carrier",
          "actor",
          "at"
        ],
        "properties": {
          "dockId": {
            "type": "string"
          },
          "dockVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "Versão da doca após este movimento"
          },
          "action": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "action",
          "expectedVersion"
        ],
        "properties": {
          "action": {
            "enum": [
              "book",
              "start",
              "release",
              "cancel"
            ]
          },
          "carrier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50,
            "description": "Obrigatória e não vazia para book; vazia ou ausente nas demais ações. Caracteres de controle são recusados."
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "docks",
          "moves",
          "sampledAt"
        ],
        "properties": {
          "docks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dock"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "moves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movement"
            },
            "maxItems": 40
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante UTC da leitura transacional na origem, preservado pela portaria."
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "actor",
          "canWrite",
          "federated",
          "csrfHeader",
          "csrf",
          "authenticated"
        ],
        "properties": {
          "actor": {
            "type": "string"
          },
          "canWrite": {
            "type": "boolean"
          },
          "federated": {
            "type": "boolean"
          },
          "csrfHeader": {
            "type": "string"
          },
          "csrf": {
            "type": "string"
          },
          "authenticated": {
            "type": "boolean",
            "description": "Identidade OIDC ainda válida; no modo local permanece false mesmo com canWrite true."
          }
        }
      }
    }
  }
}
