@page "/audit"
@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@inject Lastro.Book Book
<header><a href="/">← Voltar à mesa</a><b>LASTRO / AUDITORIA</b></header>
<main><p>LIVRO AUXILIAR</p><h1>Trilha de eventos.</h1>
@if (Http?.User.FindFirstValue("workspace") is string workspace) {
    var events = Book.Events(workspace);
    <p>@events.Count evento(s) nesta mesa. Horários em UTC.</p>
    @foreach(var ev in events) {<article><time>@ev.Stamp.Substring(0,19).Replace("T"," ")</time><h2>@ev.Ref</h2><div>@ev.Detail</div><small>@ev.Kind · @ev.Id</small></article>}
} else {<p>Abra uma mesa para consultar sua trilha.</p><a href="/">Abrir mesa</a>}
</main>
@code {[CascadingParameter] public HttpContext? Http {get;set;} }
