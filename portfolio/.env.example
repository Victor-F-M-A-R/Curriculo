# Docker Compose para a máquina local. Copie para .env somente se precisar personalizar.
POSTGRES_PASSWORD=demo-local-apenas
# Opcional para enviar leituras próprias à API do Rastro na máquina local.
# RASTRO_INGEST_TOKEN=
# Preencha ao habilitar o perfil automation e importar farol/automation/review.n8n.json.
# REVIEW_WEBHOOK_URL=http://n8n:5678/webhook/farol-review
# REVIEW_WEBHOOK_TOKEN=
# INBOX_TOKEN=
# Para selecionar excertos com um modelo compatível com Chat Completions:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=
# LLM_API_KEY=
# Projeção do livro de auditoria para um contêiner existente com partição /workspace:
# COSMOS_CONNECTION=
